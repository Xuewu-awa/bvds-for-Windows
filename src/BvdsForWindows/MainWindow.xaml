<Window x:Class="BvdsForWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BvdsForWindows.ViewModels"
        xmlns:views="clr-namespace:BvdsForWindows.Views"
        Title="BVDS — B站视频下载器 (Windows)"
        Width="980" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <vm:ToastVisibilityConverter x:Key="ToastVis"/>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Margin="10,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 内容区：左侧导航 + 页面 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="0,14">
                <StackPanel>
                    <Button Content="🏠  首页" Style="{StaticResource NavButton}" Command="{Binding GoHomeCmd}"/>
                    <Button Content="📥  下载任务" Style="{StaticResource NavButton}" Command="{Binding GoTasksCmd}"/>
                    <Button Content="🔑  登录" Style="{StaticResource NavButton}" Command="{Binding GoLoginCmd}"/>
                    <Button Content="⚙️  设置" Style="{StaticResource NavButton}" Command="{Binding GoSettingsCmd}"/>
                </StackPanel>
            </Border>

            <!-- 右侧页面 -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="24,20">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                        <views:HomeView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:TasksViewModel}">
                        <views:TasksView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                        <views:LoginView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <views:SettingsView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>

        <!-- 底部信息条（旧版样式：横贯整条，显示登录状态/提示） -->
        <Border x:Name="ToastBorder" Grid.Row="1"
                Background="#2ED8F0F0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="18,9" Visibility="{Binding Toast, Converter={StaticResource ToastVis}}">
            <TextBlock Text="{Binding Toast}" Foreground="{StaticResource TextDimBrush}" FontSize="12"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
