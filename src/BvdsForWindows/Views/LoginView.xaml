<UserControl x:Class="BvdsForWindows.Views.LoginView" Style="{StaticResource PageInStyle}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BvdsForWindows.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="420" HorizontalAlignment="Center" Margin="0,24,0,24">
            <Border Style="{StaticResource CardBorder}" Padding="28,24">
                <StackPanel>
                    <TextBlock Text="扫码登录" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="使用手机 B站 App 扫描二维码登录，登录后可下载 360P 以上画质。Cookie 本地持久化，重启保持登录。"
                               Foreground="{StaticResource TextDimBrush}" FontSize="11" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,6,0,18"/>

                    <!-- 二维码（kt 版 login-qr-wrap） -->
                    <Border Width="230" Height="230" CornerRadius="10" Background="White"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="2"
                            HorizontalAlignment="Center">
                        <Image Source="{Binding QrImage}" Stretch="Uniform" Margin="10"
                               Visibility="{Binding HasQr, Converter={x:Static vm:BoolToVis.Instance}}"/>
                    </Border>

                    <!-- 状态胶囊（kt 版 login-status） -->
                    <Border CornerRadius="99" Padding="14,6" Margin="0,16,0,0" HorizontalAlignment="Center"
                            Background="{Binding StatusBg}">
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"
                                   FontSize="12" FontWeight="Medium"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Content="开始登录" Padding="26,10" Command="{Binding StartLoginCmd}"
                                Visibility="{Binding IsLoggedIn, Converter={x:Static vm:InverseBoolToVis.Instance}}"/>
                        <Button Content="取消" Style="{StaticResource GhostButton}" Padding="26,10" Margin="10,0,0,0"
                                Command="{Binding CancelLoginCmd}"
                                Visibility="{Binding IsLoggedIn, Converter={x:Static vm:InverseBoolToVis.Instance}}"/>
                        <Button Content="退出登录" Style="{StaticResource GhostButton}" Padding="26,10"
                                Visibility="{Binding IsLoggedIn, Converter={x:Static vm:BoolToVis.Instance}}"
                                Command="{Binding LogoutCmd}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
