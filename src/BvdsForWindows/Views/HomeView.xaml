<UserControl x:Class="BvdsForWindows.Views.HomeView" Style="{StaticResource PageInStyle}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BvdsForWindows.ViewModels">
    <UserControl.Resources>
        <vm:StringEqualsConverter x:Key="StrEq"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,24,24">
            <!-- 输入卡片 -->
            <Border Style="{StaticResource CardBorder}" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="输入 B站链接" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="支持 视频 / 番剧 / 影视，可一次粘贴多个（空格、逗号、换行分隔），支持 b23.tv 短链"
                               Foreground="{StaticResource TextDimBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <TextBox Text="{Binding UrlText, UpdateSourceTrigger=PropertyChanged}"
                             Height="100" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- 下载模式：分段选择器（kt 版 mode-select） -->
            <Border Style="{StaticResource CardBorder}" Padding="18,16" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="下载模式" Style="{StaticResource CardTitle}"/>
                    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="3">
                        <UniformGrid Columns="3">
                            <RadioButton Content="视频 + 音频合轨" Style="{StaticResource SegmentButton}"
                                         IsChecked="{Binding Mode, Converter={StaticResource StrEq}, ConverterParameter=3}"/>
                            <RadioButton Content="仅视频" Style="{StaticResource SegmentButton}"
                                         IsChecked="{Binding Mode, Converter={StaticResource StrEq}, ConverterParameter=1}"/>
                            <RadioButton Content="仅音频" Style="{StaticResource SegmentButton}"
                                         IsChecked="{Binding Mode, Converter={StaticResource StrEq}, ConverterParameter=2}"/>
                        </UniformGrid>
                    </Border>

                    <TextBlock Text="清晰度" Style="{StaticResource CardTitle}" Margin="0,16,0,8"/>
                    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="3">
                        <UniformGrid Columns="5">
                            <RadioButton Content="4K" Style="{StaticResource SegmentButton}"
                                         IsChecked="{Binding Quality, Converter={StaticResource StrEq}, ConverterParameter=1}"/>
                            <RadioButton Content="1080P" Style="{StaticResource SegmentButton}"
                                         IsChecked="{Binding Quality, Converter={StaticResource StrEq}, ConverterParameter=2}"/>
                            <RadioButton Content="720P" Style="{StaticResource SegmentButton}"
                                         IsChecked="{Binding Quality, Converter={StaticResource StrEq}, ConverterParameter=3}"/>
                            <RadioButton Content="480P" Style="{StaticResource SegmentButton}"
                                         IsChecked="{Binding Quality, Converter={StaticResource StrEq}, ConverterParameter=4}"/>
                            <RadioButton Content="360P" Style="{StaticResource SegmentButton}"
                                         IsChecked="{Binding Quality, Converter={StaticResource StrEq}, ConverterParameter=5}"/>
                        </UniformGrid>
                    </Border>
                    <TextBlock Text="360P 以上画质需要扫码登录" Foreground="{StaticResource TextDimBrush}"
                               FontSize="10" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 操作行 -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="开始下载" FontSize="14" Padding="30,11" Command="{Binding StartCmd}"/>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextDimBrush}" Margin="16,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
