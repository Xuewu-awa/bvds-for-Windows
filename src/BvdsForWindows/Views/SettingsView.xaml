<UserControl x:Class="BvdsForWindows.Views.SettingsView" Style="{StaticResource PageInStyle}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BvdsForWindows.ViewModels">
    <UserControl.Resources>
        <vm:StringEqualsConverter x:Key="StrEq"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch" Margin="0,0,24,24">
            <TextBlock Text="设置" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/>

            <!-- 下载目录 -->
            <Border Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="下载目录" Style="{StaticResource CardTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding DownloadDir, UpdateSourceTrigger=PropertyChanged}" FontSize="12"/>
                        <Button Grid.Column="1" Content="浏览..." Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Padding="14,7" MinHeight="0" FontSize="11" Command="{Binding BrowseDirCmd}"/>
                        <Button Grid.Column="2" Content="打开" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Padding="14,7" MinHeight="0" FontSize="11" Command="{Binding OpenDownloadDirCmd}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 主题 -->
            <Border Style="{StaticResource CardBorder}" Padding="26,22" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="主题" Style="{StaticResource CardTitle}"/>
                    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="3" HorizontalAlignment="Left">
                        <UniformGrid Columns="2">
                            <RadioButton Content="青色" Style="{StaticResource SegmentButton}" Padding="22,7"
                                         IsChecked="{Binding Theme, Converter={StaticResource StrEq}, ConverterParameter=teal}"/>
                            <RadioButton Content="琥珀" Style="{StaticResource SegmentButton}" Padding="22,7"
                                         IsChecked="{Binding Theme, Converter={StaticResource StrEq}, ConverterParameter=amber}"/>
                        </UniformGrid>
                    </Border>
                    <Button Content="保存设置" Margin="0,14,0,0" HorizontalAlignment="Left"
                            Command="{Binding SaveSettingsCmd}"/>
                </StackPanel>
            </Border>

            <!-- 并发下载 -->
            <Border Style="{StaticResource CardBorder}" Padding="26,22" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="并发下载数" Style="{StaticResource CardTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="ConcurrentSlider" Grid.Column="0" Minimum="1" Maximum="64"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="ConcurrentSlider_ValueChanged"
                                Value="{Binding MaxConcurrent, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding MaxConcurrent}" MinWidth="28"
                                   FontSize="15" FontWeight="SemiBold" TextAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}" Margin="16,0,0,0"/>
                    </Grid>
                    <TextBlock Text="同时下载的任务数量，数值越大越占带宽（建议 5-8）"
                               Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 调试日志 -->
            <Border Style="{StaticResource CardBorder}" Padding="26,22" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="调试日志" Style="{StaticResource CardTitle}"/>
                    <TextBox Text="{Binding LogText, Mode=OneWay}" Height="180" IsReadOnly="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="10" Background="{StaticResource BgBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="刷新" Style="{StaticResource GhostButton}" Padding="14,7" MinHeight="0"
                                FontSize="11" Command="{Binding RefreshLogCmd}"/>
                        <Button Content="导出到下载目录" Style="{StaticResource GhostButton}" Padding="14,7" MinHeight="0"
                                FontSize="11" Margin="8,0,0,0" Command="{Binding ExportLogCmd}"/>
                        <Button Content="清空" Style="{StaticResource GhostButton}" Padding="14,7" MinHeight="0"
                                FontSize="11" Margin="8,0,0,0" Command="{Binding ClearLogCmd}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
