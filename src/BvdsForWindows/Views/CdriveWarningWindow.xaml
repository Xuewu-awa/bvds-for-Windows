<Window x:Class="BvdsForWindows.Views.CdriveWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下载目录提醒" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI" Opacity="0">
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <StackPanel Margin="22,18">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="⚠️" FontSize="26" VerticalAlignment="Top"/>
            <TextBlock Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="350" FontSize="13"
                       Text="当前下载目录在 C 盘（系统盘）。视频文件较大，建议保存到其他磁盘，避免占用系统盘空间、影响系统性能。" />
        </StackPanel>

        <TextBlock x:Name="DirText" Foreground="{StaticResource TextDimBrush}" FontSize="12"
                   Margin="36,8,0,0" TextTrimming="CharacterEllipsis"/>

        <CheckBox x:Name="DontAskBox" Content="以后不再提醒（下载目录仍可随时在设置中修改）"
                  Margin="36,14,0,0" FontSize="12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="继续下载" Style="{StaticResource GhostButton}" Padding="16,8"
                    IsCancel="True" Click="Continue_Click"/>
            <Button Content="更换目录" Padding="18,8" Margin="10,0,0,0"
                    IsDefault="True" Click="ChangeDir_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
